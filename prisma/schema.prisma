// Prisma schema for the Verdanta perks store.
// PostgreSQL for development and production.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A purchase order. Lifecycle:
//   awaiting_payment -> pending_review -> approved | rejected
model Order {
  serverId        String @default("default")
  server          Server @relation(fields: [serverId], references: [id], onDelete: Restrict)
  paymentUpiId    String?
  paymentPayee    String?
  id              String   @id @default(cuid())
  planSlug        String
  planName        String
  amount          Int // in the smallest currency unit is overkill for INR here; stored as whole rupees
  subtotal        Int
  discountAmount  Int      @default(0)
  couponCode      String?
  currency        String   @default("INR")
  note            String   @unique // unique payment note shown to the buyer / encoded in the UPI intent

  status          String   @default("awaiting_payment")
  deliveryStatus  String   @default("not_requested")
  deliveryGuildId String?
  deliveryRoleId  String?
  deliveryToken   String?
  deliveryLeaseUntil DateTime?
  deliveryRetryAt DateTime?
  deliveryError   String?
  deliveredAt     DateTime?
  deliveryAttempts Int    @default(0)

  // Buyer identity comes from the authenticated Discord session (never client input).
  discordUserId   String
  discordUsername String

  // Payment proof (submitted after payment).
  utr             String?  @unique // 12-digit UPI reference; UNIQUE blocks reuse across orders
  screenshotPath  String? // Base64 data URI, served via a gated route
  screenshotHash  String? // sha256 of the uploaded image, for duplicate detection
  duplicateFlag   Boolean  @default(false) // set when the same screenshot hash was seen before

  // Admin review.
  reviewedBy      String?
  reviewNote      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([discordUserId])
  @@index([serverId, status, createdAt])
}

model Coupon {
  serverId    String @default("default")
  server      Server @relation(fields: [serverId], references: [id], onDelete: Restrict)
  id          String   @id @default(cuid())
  code        String
  kind        String // percent or fixed (whole rupees)
  value       Int
  active      Boolean  @default(true)
  minAmount   Int      @default(0)
  planSlug    String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@unique([serverId, code])
}

model Product {
  serverId String @default("default")
  server Server @relation(fields: [serverId], references: [id], onDelete: Restrict)
  slug String
  data Json
  enabled Boolean @default(true)
  roleId String?
  updatedAt DateTime @updatedAt
  @@id([serverId, slug])
}

model StoreSettings {
  serverId String @unique @default("default")
  server Server @relation(fields: [serverId], references: [id], onDelete: Restrict)
  id String @id @default("default")
  primaryColor String @default("#2f855a")
  accentColor String @default("#14a5a0")
  updatedAt DateTime @updatedAt
}

model Server {
  id String @id @default(cuid())
  guildId String? @unique
  name String
  icon String?
  inviteUrl String @default("")
  upiId String @default("")
  payeeName String @default("")
  botKey String @default("shared")
  status String @default("active")
  version Int @default(1)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders Order[]
  products Product[]
  coupons Coupon[]
  settings StoreSettings?
  access ServerAccess[]
  audit AuditEvent[]
}

model ServerAccess {
  serverId String
  userId String
  role String
  grantedBy String
  updatedAt DateTime @updatedAt
  server Server @relation(fields: [serverId], references: [id], onDelete: Restrict)
  @@id([serverId, userId])
  @@index([userId])
}

model PlatformAccess {
  userId String @id
  role String // administrator or registrar
  updatedAt DateTime @updatedAt
}

model DiscordAuthorization {
  userId String @id
  credentials String // authenticated encryption, never returned to clients
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model AuditEvent {
  id String @id @default(cuid())
  serverId String?
  server Server? @relation(fields: [serverId], references: [id], onDelete: Restrict)
  actorId String
  action String
  outcome String
  createdAt DateTime @default(now())
  @@index([serverId, createdAt])
}

model DiscordRateGate {
  id String @id
  nextAt DateTime
}
