# ---- Copy this file to .env and fill in your values ----

# PostgreSQL database. On a new database, run: npm run db:migrate
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discord_community"

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET=""
# The canonical URL of the app (used for OAuth callbacks).
AUTH_URL="http://localhost:3000"

# ---- Discord OAuth ----
# 1. Create an app at https://discord.com/developers/applications
# 2. OAuth2 > add redirect: http://localhost:3000/api/auth/callback/discord
# 3. Copy the Client ID / Client Secret below.
# Leave both blank in development to use the built-in "Dev Login".
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# ---- Discord server ----
# Guild id enables the live member count. Requires "Server Widget" enabled in
# Discord: Server Settings > Widget > Enable Server Widget.
DISCORD_GUILD_ID=""
# Public invite link for "Join Discord" CTAs.
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/your-invite"

# ---- Admin access ----
# Comma-separated Discord user ids that may open /admin.
ADMIN_DISCORD_IDS=""
# Mock login is only available under npm run dev, never in production.

# ---- Role delivery after manual approval (server-only secrets/settings) ----
# Install the bot in the guild with Manage Roles and place its role above these.
DISCORD_BOT_TOKEN=""
DISCORD_ROLE_PREMIUM=""
DISCORD_ROLE_PREMIUM_PRO=""
DISCORD_ROLE_PREMIUM_PLUS=""

# ---- UPI payment details (manual UPI flow) ----
NEXT_PUBLIC_UPI_ID="yourname@upi"
NEXT_PUBLIC_UPI_PAYEE_NAME="Your Store Name"
# Server-side key for Discord OAuth grants (32 random bytes encoded as 64 hex characters).
# Keep outside the database. Rotating it requires users to reconnect Discord.
CONFIG_ENCRYPTION_KEY=""
